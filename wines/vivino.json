{
  "recipe_shortcut": "vivino_wines",
  "list_type": "wines",
  "engine_version": 26,
  "title": "Vivino Wines",
  "description": "Retrieve the wines from page vivino",
  "urls": [
    "vivino.com",
    "https://vivino.com",
    "https://www.vivino.com"
  ],
  "headers": {
    "Accept-Language": "en-UK,en",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/81.0.4044.113 Safari/537.36"
  },
  "autocomplete_steps": [
    {
      "command": "url_encode",
      "input": "$INPUT",
      "output": {
        "name": "ENCODED_INPUT",
        "show": false
      },
      "description": "Encode the wine search query"
    },
    {
      "command": "api_request",
      "url": "https://9TAKGWJUXL-dsn.algolia.net/1/indexes/WINES_prod/query",
      "output": {
        "name": "SEARCH_JSON",
        "show": false
      },
      "config": {
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "x-algolia-application-id": "9TAKGWJUXL",
          "x-algolia-api-key": "60c11b2f1068885161d95ca068d3a6ae"
        },
        "body": "{\"params\":\"query=$ENCODED_INPUT&hitsPerPage=10\"}"
      },
      "description": "Search Vivino's public wine index"
    },
    {
      "command": "json_count",
      "input": "$SEARCH_JSON",
      "locator": "hits",
      "output": {
        "name": "NUMBER_OF_RESULTS",
        "type": "int",
        "show": false
      },
      "description": "Count matching wines"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "hits.[$i].vintages.[0].name",
      "output": {
        "name": "TITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract each wine title"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "hits.[$i].region.name",
      "output": {
        "name": "SUBTITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract each wine region"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "hits.[$i].image.variations.bottle_small",
      "output": {
        "name": "COVER_PATH$i",
        "show": false
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract each bottle image"
    },
    {
      "command": "store",
      "input": "https:$COVER_PATH$i",
      "output": {
        "name": "COVER$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Make bottle image URLs absolute"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "hits.[$i].vintages.[0].id",
      "output": {
        "name": "VINTAGE_ID$i",
        "show": false
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract each matching vintage ID"
    },
    {
      "command": "store",
      "input": "https://www.vivino.com/wines/$VINTAGE_ID$i",
      "output": {
        "name": "URL$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Build stable Vivino vintage URLs"
    }
  ],
  "url_steps": [
    {
      "command": "regex",
      "input": "$INPUT",
      "expression": "\\/wines\\/(\\d+)",
      "output": {
        "name": "VINTAGE_ID",
        "show": false
      },
      "description": "Extract the Vivino vintage ID"
    },
    {
      "command": "api_request",
      "url": "https://www.vivino.com/api/vintages/$VINTAGE_ID",
      "output": {
        "name": "DETAIL_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json",
          "Accept-Language": "en-US,en;q=0.9",
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:131.0) Gecko/20100101 Firefox/131.0"
        }
      },
      "description": "Load structured Vivino vintage details"
    },
    {
      "command": "store",
      "input": "$INPUT",
      "output": {
        "name": "URL",
        "type": "string",
        "show": true
      },
      "description": "Preserve the Vivino vintage URL"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.name",
      "output": {
        "name": "TITLE",
        "type": "string",
        "show": true
      },
      "description": "Extract the wine title"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.winery.name",
      "output": {
        "name": "WINERY",
        "type": "string",
        "show": true
      },
      "description": "Extract the winery"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.year",
      "output": {
        "name": "VINTAGE",
        "type": "string",
        "show": true
      },
      "description": "Extract the vintage year"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.style.name",
      "output": {
        "name": "STYLE",
        "type": "string",
        "show": true
      },
      "description": "Extract the wine style"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.statistics.ratings_average",
      "output": {
        "name": "RATING",
        "type": "float",
        "show": true
      },
      "description": "Extract the average rating"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.grapes.[0].name",
      "output": {
        "name": "GRAPES",
        "type": "string",
        "show": true
      },
      "description": "Extract the primary grape"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.region.country.name",
      "output": {
        "name": "COUNTRY",
        "type": "string",
        "show": true
      },
      "description": "Extract the wine country"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.region.name",
      "output": {
        "name": "PLACE",
        "type": "string",
        "show": true
      },
      "description": "Extract the wine region"
    },
    {
      "command": "store",
      "input": "$COUNTRY, $PLACE",
      "output": {
        "name": "REGION",
        "type": "string",
        "show": true
      },
      "description": "Compose the full wine region"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.image.variations.bottle_large",
      "output": {
        "name": "COVER_PATH",
        "show": false
      },
      "description": "Extract the bottle image path"
    },
    {
      "command": "store",
      "input": "https:$COVER_PATH",
      "output": {
        "name": "COVER",
        "type": "string",
        "show": true
      },
      "description": "Make the bottle image URL absolute"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "vintage.wine.style.description",
      "output": {
        "name": "DESCRIPTION",
        "type": "string",
        "show": true
      },
      "description": "Extract the wine style description"
    },
    {
      "command": "store",
      "input": "$INPUT",
      "output": {
        "name": "URL_SALE",
        "type": "string",
        "show": true
      },
      "description": "Use the Vivino URL as the purchase link"
    }
  ]
}
