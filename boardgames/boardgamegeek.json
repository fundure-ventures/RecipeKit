{
  "recipe_shortcut": "boardgamegeek_boardgames",
  "list_type": "boardgames",
  "engine_version": 24,
  "title": "Boardgames Geek Boardgames",
  "description": "A recipe to get a list of boardgames",
  "urls": [
    "https://www.boardgamegeek.com",
    "https://boardgamegeek.com/boardgame/",
    "https://www.boardgamegeek.com/boardgame/",
    "https://boardgamegeek.com/boardgame/",
    "http://boardgamegeek.com/boardgame/",
    "http://boardgamegeek.com/",
    "http://boardgamegeek.com/"
  ],
  "headers": {
    "Accept-Language": "en-UK,en",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/81.0.4044.113 Safari/537.36"
  },
  "autocomplete_steps": [
    {
      "command": "load",
      "url": "https://www.boardgamegeek.com/search/boardgame?q=$INPUT&showcount=20",
      "description": "Searches boards game by title"
    },
    {
      "command": "store_attribute",
      "locator": "table.collection_table tr:nth-child($i) img",
      "attribute_name": "src",
      "output": {
        "name": "COVER$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    },
    {
      "command": "store_text",
      "locator": "table.collection_table tr:nth-child($i) td.collection_objectname a",
      "output": {
        "name": "TITLE$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    },
    {
      "command": "store_text",
      "locator": "table.collection_table tr:nth-child($i) td.collection_objectname span",
      "output": {
        "name": "SUBTITLE$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    },
    {
      "command": "regex",
      "input": "$SUBTITLE$i",
      "expression": "(\\d\\d\\d\\d)",
      "output": {
        "name": "SUBTITLE$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    },
    {
      "command": "store_attribute",
      "locator": "table.collection_table tr:nth-child($i) td.collection_objectname a",
      "attribute_name": "href",
      "output": {
        "name": "URL$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    },
    {
      "command": "store",
      "input": "https://www.boardgamegeek.com$URL$i",
      "output": {
        "name": "URL$i"
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 2,
          "to": 7,
          "step": 1
        }
      }
    }
  ],
  "url_steps": [
    {
      "command": "regex",
      "input": "$INPUT",
      "expression": "\\/boardgame\\/(\\d+)",
      "output": {
        "name": "GAME_ID"
      },
      "description": "Extracts the BoardGameGeek game ID"
    },
    {
      "command": "api_request",
      "url": "https://api.geekdo.com/api/geekitems?objectid=$GAME_ID&objecttype=thing&subtype=boardgame",
      "output": {
        "name": "DETAIL_JSON"
      },
      "config": {
        "method": "GET"
      },
      "description": "Loads game details from the Geekdo JSON API"
    },
    {
      "command": "json_store_text",
      "locator": "item.canonical_link",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "URL",
        "type": "string",
        "show": true
      },
      "description": "Saves the canonical BoardGameGeek URL"
    },
    {
      "command": "json_store_text",
      "locator": "item.name",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "TITLE",
        "type": "string",
        "show": true
      },
      "description": "Extracts the game title"
    },
    {
      "command": "json_store_text",
      "locator": "item.short_description",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "DESCRIPTION",
        "type": "string",
        "show": true
      },
      "description": "Extracts the short game description"
    },
    {
      "command": "json_store_text",
      "locator": "item.imageurl",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "COVER",
        "type": "string",
        "show": true
      },
      "description": "Extracts the game cover"
    },
    {
      "command": "api_request",
      "url": "https://api.geekdo.com/api/dynamicinfo?objectid=$GAME_ID&objecttype=thing&subtype=boardgame",
      "output": {
        "name": "DYNAMIC_JSON"
      },
      "config": {
        "method": "GET"
      },
      "description": "Loads the game rating from the Geekdo JSON API"
    },
    {
      "command": "json_store_text",
      "locator": "item.stats.average",
      "input": "$DYNAMIC_JSON",
      "output": {
        "name": "RATING",
        "type": "float",
        "show": true
      },
      "description": "Extracts the average rating"
    },
    {
      "command": "json_store_text",
      "locator": "item.yearpublished",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "DATE",
        "type": "date",
        "format": "YYYY",
        "show": true
      },
      "description": "Extracts the publication year"
    },
    {
      "command": "json_store_text",
      "locator": "item.minplaytime",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "TIME"
      },
      "description": "Extracts the minimum play time"
    },
    {
      "command": "store",
      "input": "$TIME min",
      "output": {
        "name": "TIME",
        "type": "string",
        "show": true
      }
    },
    {
      "command": "json_store_text",
      "locator": "item.minplayers",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "PLAYERS_MIN",
        "type": "string",
        "show": false
      },
      "description": "Extracts the minimum player count"
    },
    {
      "command": "json_store_text",
      "locator": "item.maxplayers",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "PLAYERS_MAX",
        "type": "string",
        "show": false
      },
      "description": "Extracts the maximum player count"
    },
    {
      "command": "store",
      "input": "$PLAYERS_MIN - $PLAYERS_MAX",
      "output": {
        "name": "PLAYERS",
        "type": "string",
        "show": true
      }
    },
    {
      "command": "json_store_text",
      "locator": "item.links.boardgamecategory.[0].name",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "CATEGORY",
        "type": "string",
        "show": true
      },
      "description": "Extracts the primary game category"
    }
  ]
}
