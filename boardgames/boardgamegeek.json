{
  "recipe_shortcut": "boardgamegeek_boardgames",
  "list_type": "boardgames",
  "engine_version": 24,
  "title": "Boardgames Geek Boardgames",
  "description": "A recipe to get a list of boardgames",
  "urls": [
    "https://www.boardgamegeek.com",
    "https://boardgamegeek.com/boardgame/",
    "https://www.boardgamegeek.com/boardgame/",
    "https://boardgamegeek.com/boardgame/",
    "http://boardgamegeek.com/boardgame/",
    "http://boardgamegeek.com/",
    "http://boardgamegeek.com/"
  ],
  "headers": {
    "Accept-Language": "en-UK,en",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/81.0.4044.113 Safari/537.36"
  },
  "autocomplete_steps": [
    {
      "command": "store",
      "input": "SELECT ?item ?itemLabel ?bgg WHERE { ?item wdt:P2339 ?bgg; rdfs:label ?itemLabel. FILTER(LANG(?itemLabel) = \"en\") FILTER(CONTAINS(LCASE(?itemLabel), LCASE(\"$INPUT\"))) } LIMIT 10",
      "output": {
        "name": "SEARCH_QUERY",
        "show": false
      },
      "description": "Build a Wikidata query for board games with BoardGameGeek IDs"
    },
    {
      "command": "url_encode",
      "input": "$SEARCH_QUERY",
      "output": {
        "name": "ENCODED_QUERY",
        "show": false
      },
      "description": "Encode the Wikidata query"
    },
    {
      "command": "api_request",
      "url": "https://query.wikidata.org/sparql?query=$ENCODED_QUERY&format=json",
      "output": {
        "name": "SEARCH_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/sparql-results+json",
          "User-Agent": "RecipeKit/1.0 (https://github.com/fundure-ventures/RecipeKit)"
        }
      },
      "description": "Search Wikidata for BoardGameGeek IDs"
    },
    {
      "command": "json_count",
      "input": "$SEARCH_JSON",
      "locator": "results.bindings",
      "output": {
        "name": "NUMBER_OF_RESULTS",
        "show": false
      },
      "description": "Count matching board games"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "results.bindings.[$i].bgg.value",
      "output": {
        "name": "GAME_ID$i",
        "show": false
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract BoardGameGeek IDs"
    },
    {
      "command": "api_request",
      "url": "https://api.geekdo.com/api/geekitems?objectid=$GAME_ID$i&objecttype=thing&subtype=boardgame",
      "output": {
        "name": "DETAIL_JSON$i",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        },
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Load details for each BoardGameGeek result"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON$i",
      "locator": "item.name",
      "output": {
        "name": "TITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract board game titles"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON$i",
      "locator": "item.yearpublished",
      "output": {
        "name": "SUBTITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract publication years"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON$i",
      "locator": "item.imageurl",
      "output": {
        "name": "COVER$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract board game covers"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON$i",
      "locator": "item.canonical_link",
      "output": {
        "name": "URL$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract canonical BoardGameGeek URLs"
    }
  ],
  "url_steps": [
    {
      "command": "regex",
      "input": "$INPUT",
      "expression": "\\/boardgame\\/(\\d+)",
      "output": {
        "name": "GAME_ID"
      },
      "description": "Extracts the BoardGameGeek game ID"
    },
    {
      "command": "api_request",
      "url": "https://api.geekdo.com/api/geekitems?objectid=$GAME_ID&objecttype=thing&subtype=boardgame",
      "output": {
        "name": "DETAIL_JSON"
      },
      "config": {
        "method": "GET"
      },
      "description": "Loads game details from the Geekdo JSON API"
    },
    {
      "command": "json_store_text",
      "locator": "item.canonical_link",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "URL",
        "type": "string",
        "show": true
      },
      "description": "Saves the canonical BoardGameGeek URL"
    },
    {
      "command": "json_store_text",
      "locator": "item.name",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "TITLE",
        "type": "string",
        "show": true
      },
      "description": "Extracts the game title"
    },
    {
      "command": "json_store_text",
      "locator": "item.short_description",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "DESCRIPTION",
        "type": "string",
        "show": true
      },
      "description": "Extracts the short game description"
    },
    {
      "command": "json_store_text",
      "locator": "item.imageurl",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "COVER",
        "type": "string",
        "show": true
      },
      "description": "Extracts the game cover"
    },
    {
      "command": "api_request",
      "url": "https://api.geekdo.com/api/dynamicinfo?objectid=$GAME_ID&objecttype=thing&subtype=boardgame",
      "output": {
        "name": "DYNAMIC_JSON"
      },
      "config": {
        "method": "GET"
      },
      "description": "Loads the game rating from the Geekdo JSON API"
    },
    {
      "command": "json_store_text",
      "locator": "item.stats.average",
      "input": "$DYNAMIC_JSON",
      "output": {
        "name": "RATING",
        "type": "float",
        "show": true
      },
      "description": "Extracts the average rating"
    },
    {
      "command": "json_store_text",
      "locator": "item.yearpublished",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "DATE",
        "type": "date",
        "format": "YYYY",
        "show": true
      },
      "description": "Extracts the publication year"
    },
    {
      "command": "json_store_text",
      "locator": "item.minplaytime",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "TIME"
      },
      "description": "Extracts the minimum play time"
    },
    {
      "command": "store",
      "input": "$TIME min",
      "output": {
        "name": "TIME",
        "type": "string",
        "show": true
      }
    },
    {
      "command": "json_store_text",
      "locator": "item.minplayers",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "PLAYERS_MIN",
        "type": "string",
        "show": false
      },
      "description": "Extracts the minimum player count"
    },
    {
      "command": "json_store_text",
      "locator": "item.maxplayers",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "PLAYERS_MAX",
        "type": "string",
        "show": false
      },
      "description": "Extracts the maximum player count"
    },
    {
      "command": "store",
      "input": "$PLAYERS_MIN - $PLAYERS_MAX",
      "output": {
        "name": "PLAYERS",
        "type": "string",
        "show": true
      }
    },
    {
      "command": "json_store_text",
      "locator": "item.links.boardgamecategory.[0].name",
      "input": "$DETAIL_JSON",
      "output": {
        "name": "CATEGORY",
        "type": "string",
        "show": true
      },
      "description": "Extracts the primary game category"
    }
  ]
}
