{
  "recipe_shortcut": "allaboutbirdsorg",
  "list_type": "generic",
  "engine_version": 20,
  "title": "Allaboutbirds.org",
  "description": "Retrieve generic from allaboutbirds.org",
  "urls": [
    "https://allaboutbirds.org",
    "https://www.allaboutbirds.org"
  ],
  "headers": {
    "Accept-Language": "en-UK,en",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/81.0.4044.113 Safari/537.36"
  },
  "autocomplete_steps": [
    {
      "command": "url_encode",
      "input": "$INPUT",
      "output": {
        "name": "ENCODED_INPUT",
        "show": false
      },
      "description": "Encode the bird search query"
    },
    {
      "command": "api_request",
      "url": "https://birdnet.cornell.edu/taxonomy/api/search?q=$ENCODED_INPUT&per_page=10",
      "output": {
        "name": "SEARCH_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "description": "Search Cornell's bird taxonomy"
    },
    {
      "command": "json_count",
      "input": "$SEARCH_JSON",
      "locator": "results",
      "output": {
        "name": "NUMBER_OF_RESULTS",
        "show": false
      },
      "description": "Count matching bird species"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "results.[$i].common_name",
      "output": {
        "name": "TITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract common bird names"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "results.[$i].common_name",
      "output": {
        "name": "SUBTITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Use the common name as the result subtitle"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "results.[$i].image.medium",
      "output": {
        "name": "COVER$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract bird thumbnail images"
    },
    {
      "command": "replace",
      "input": "$TITLE$i",
      "find": " ",
      "replace": "_",
      "output": {
        "name": "SLUG$i",
        "show": false
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Build All About Birds guide slugs"
    },
    {
      "command": "store",
      "input": "https://www.allaboutbirds.org/guide/$SLUG$i/",
      "output": {
        "name": "URL$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Build All About Birds guide URLs"
    }
  ],
  "url_steps": [
    {
      "command": "regex",
      "input": "$INPUT",
      "expression": "\\/guide\\/([^/]+)",
      "output": {
        "name": "GUIDE_SLUG",
        "show": false
      },
      "description": "Extract the bird guide slug"
    },
    {
      "command": "replace",
      "input": "$GUIDE_SLUG",
      "find": "_",
      "replace": " ",
      "output": {
        "name": "SEARCH_TERM",
        "show": false
      },
      "description": "Convert the guide slug into a bird name"
    },
    {
      "command": "url_encode",
      "input": "$SEARCH_TERM",
      "output": {
        "name": "ENCODED_SEARCH_TERM",
        "show": false
      },
      "description": "Encode the bird name"
    },
    {
      "command": "api_request",
      "url": "https://birdnet.cornell.edu/taxonomy/api/search?q=$ENCODED_SEARCH_TERM&per_page=1",
      "output": {
        "name": "DETAIL_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "description": "Load Cornell bird metadata"
    },
    {
      "command": "store",
      "input": "$INPUT",
      "output": {
        "name": "URL",
        "type": "string",
        "show": true
      },
      "description": "Preserve the All About Birds guide URL"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "results.[0].common_name",
      "output": {
        "name": "TITLE",
        "type": "string",
        "show": true
      },
      "description": "Extract the bird name"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "results.[0].descriptions.en",
      "output": {
        "name": "DESCRIPTION",
        "type": "string",
        "show": true
      },
      "description": "Extract the bird description"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "results.[0].image.medium",
      "output": {
        "name": "COVER",
        "type": "string",
        "show": true
      },
      "description": "Extract the bird image"
    },
    {
      "command": "store",
      "input": "https://www.allaboutbirds.org/favicon.ico",
      "output": {
        "name": "FAVICON",
        "type": "string",
        "show": true
      },
      "description": "Set the All About Birds favicon"
    }
  ]
}