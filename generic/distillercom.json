{
  "recipe_shortcut": "distillercom",
  "list_type": "generic",
  "engine_version": 20,
  "title": "Distiller.com",
  "description": "Retrieve generic from distiller.com",
  "urls": [
    "https://distiller.com",
    "https://www.distiller.com"
  ],
  "headers": {
    "Accept-Language": "en-UK,en",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/81.0.4044.113 Safari/537.36"
  },
  "autocomplete_steps": [
    {
      "command": "url_encode",
      "input": "$INPUT",
      "output": {
        "name": "ENCODED_INPUT",
        "show": false
      },
      "description": "Encode the spirit search query"
    },
    {
      "command": "api_request",
      "url": "https://distiller.com/api/spirits/search-help?term=$ENCODED_INPUT",
      "output": {
        "name": "SEARCH_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json",
          "X-DISTILLER-DEVELOPER-TOKEN": "8e01b58d-6bc8-407e-b7fb-5b989b5b23e9"
        }
      },
      "description": "Search Distiller's JSON API"
    },
    {
      "command": "json_count",
      "input": "$SEARCH_JSON",
      "locator": "spirits",
      "output": {
        "name": "NUMBER_OF_RESULTS",
        "show": false
      },
      "description": "Count matching spirits"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "spirits.[$i].name",
      "output": {
        "name": "TITLE$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract spirit names"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "spirits.[$i].slug",
      "output": {
        "name": "SLUG$i",
        "show": false
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract spirit slugs"
    },
    {
      "command": "store",
      "input": "https://distiller.com/spirits/$SLUG$i",
      "output": {
        "name": "URL$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Build canonical spirit URLs"
    },
    {
      "command": "json_store_text",
      "input": "$SEARCH_JSON",
      "locator": "spirits.[$i].thumbnail_image_url",
      "output": {
        "name": "COVER$i",
        "show": true
      },
      "config": {
        "loop": {
          "index": "i",
          "from": 0,
          "to": "$NUMBER_OF_RESULTS - 1",
          "step": 1
        }
      },
      "description": "Extract spirit thumbnail images"
    }
  ],
  "url_steps": [
    {
      "command": "regex",
      "input": "$INPUT",
      "expression": "\\/spirits\\/([^/?]+)",
      "output": {
        "name": "SLUG",
        "show": false
      },
      "description": "Extract the spirit slug"
    },
    {
      "command": "api_request",
      "url": "https://distiller.com/api/spirits/$SLUG",
      "output": {
        "name": "DETAIL_JSON",
        "show": false
      },
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/json",
          "X-DISTILLER-DEVELOPER-TOKEN": "8e01b58d-6bc8-407e-b7fb-5b989b5b23e9"
        }
      },
      "description": "Load structured spirit details"
    },
    {
      "command": "store",
      "input": "$INPUT",
      "output": {
        "name": "URL",
        "type": "string",
        "show": true
      },
      "description": "Preserve the canonical spirit URL"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.name",
      "output": {
        "name": "TITLE",
        "type": "string",
        "show": true
      },
      "description": "Extract spirit name"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.description",
      "output": {
        "name": "DESCRIPTION",
        "type": "string",
        "show": true
      },
      "description": "Extract the spirit description"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.image_urls.large",
      "output": {
        "name": "COVER",
        "type": "string",
        "show": true
      },
      "description": "Extract the spirit cover image"
    },
    {
      "command": "store",
      "input": "https://distiller.com/favicon.ico",
      "output": {
        "name": "FAVICON",
        "type": "string",
        "show": true
      },
      "description": "Set the Distiller favicon"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.average_rating",
      "output": {
        "name": "RATING",
        "type": "float",
        "show": true
      },
      "description": "Extract community rating"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.style.name",
      "output": {
        "name": "STYLE",
        "type": "string",
        "show": true
      },
      "description": "Extract spirit style (e.g. Bourbon)"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.brand.name",
      "output": {
        "name": "BRAND",
        "type": "string",
        "show": true
      },
      "description": "Extract brand and location"
    },
    {
      "command": "json_store_text",
      "input": "$DETAIL_JSON",
      "locator": "spirit.distiller_score",
      "output": {
        "name": "SCORE",
        "type": "integer",
        "show": true
      },
      "description": "Extract Distiller expert score"
    }
  ]
}